            particles = [];
            lasers = [];
            floatingTexts = [];
            activeTarget = null;
            gameRunning = true;
            isPaused = false;

            startWave(currentWave);
            requestAnimationFrame(gameLoop);
        }

        function startWave(waveNum) {
            currentWave = waveNum;
            minionIndex = 0;
            isBossActive = false;

            const pool = [...campaignData[waveNum - 1].minionPool].sort(() => Math.random() - 0.5);
            currentWaveMinions = pool.slice(0, 10);

            updateProgressUI();
            updateHUD();
            spawnNextInWave();
        }

        // --- ⏸️ 暫停、繼續、重玩、放棄 ---
        function pauseGame() {
            if (!gameRunning || isPaused) return;
            isPaused = true;
            document.getElementById('pause-wave-num').innerText = currentWave;
            document.getElementById('pause-screen').classList.remove('hidden');
        }

        function resumeGame() {
            if (!gameRunning || !isPaused) return;
            isPaused = false;
            document.getElementById('pause-screen').classList.add('hidden');
            requestAnimationFrame(gameLoop);
        }

        function restartCurrentWave() {
            document.getElementById('pause-screen').classList.add('hidden');
            isPaused = false;
            hp = 100;
            meteors = [];
            particles = [];
            lasers = [];
            activeTarget = null;
            startWave(currentWave);
            requestAnimationFrame(gameLoop);
        }

        function giveUpAndHome() {
            showStartScreen();
        }

        function updateProgressUI() {
            const fill = document.getElementById('progress-fill');
            const text = document.getElementById('progress-text');

            if (minionIndex < 10) {
                fill.className = "progress-fill";
                fill.style.width = `${(minionIndex / 10) * 100}%`;
                text.innerText = `👾 雜兵 ${minionIndex} / 10`;
            } else {
                fill.className = "progress-fill boss-ready";
                fill.style.width = `100%`;
                text.innerText = `👑 BOSS 決戰！`;
            }
        }

        function spawnNextInWave() {
            const waveData = campaignData[currentWave - 1];
            const speedMod = gameMode === 'normal' ? 0.75 : 1.05;

            if (minionIndex < 10) {
                const qData = currentWaveMinions[minionIndex];
                meteors.push({
                    x: Math.random() * (width - 240) + 120,
                    y: -50,
                    radius: 36,
                    speed: (0.72 + currentWave * 0.05) * speedMod,
                    exp: qData.exp,
                    ans: qData.ans,
                    opts: qData.opts,
                    hint: qData.hint,
                    isBoss: false,
                    color: '#00f0ff'
                });
                setNewTarget();
            } else if (minionIndex === 10 && !isBossActive) {
                triggerBossEncounter(waveData.boss);
            }
        }

        function triggerBossEncounter(bossData) {
            isBossActive = true;
            playSfx('boss_warning');

            const banner = document.getElementById('boss-banner');
            banner.innerText = `⚠️ WARNING: ${bossData.name} 降臨 ⚠️`;
            banner.classList.add('show');
            setTimeout(() => banner.classList.remove('show'), 1600);

            const bossSpeed = gameMode === 'normal' ? 0.12 : 0.17;
            setTimeout(() => {
                meteors.push({
                    x: width / 2,
                    y: -80,
                    radius: 56,
                    speed: bossSpeed,
                    exp: bossData.exp,
                    ans: bossData.ans,
                    opts: bossData.opts,
                    hint: bossData.hint,
                    isBoss: true,
                    bossName: bossData.name,
                    color: '#ff007f'
                });
                setNewTarget();
            }, 800);
        }

        function setNewTarget() {
            if (meteors.length === 0) {
                document.getElementById('ammo-grid').innerHTML = '';
                activeTarget = null;
                return;
            }
            activeTarget = meteors[0];

            const grid = document.getElementById('ammo-grid');
            grid.innerHTML = '';

            const shuffled = [...activeTarget.opts].sort(() => Math.random() - 0.5);
            shuffled.forEach(opt => {
                const btn = document.createElement('button');
                btn.className = 'missile-btn';
                btn.innerHTML = formatSup(opt);
                btn.onclick = () => shootMissile(opt, btn);
                grid.appendChild(btn);
            });
        }

        function formatSup(text) {
            return text.toString().replace(/\^([0-9a-zA-Z\-\+]+)/g, '<sup>$1</sup>');
        }

        function shootMissile(chosenAns, btnEl) {
            if (!gameRunning || isPaused || !activeTarget) return;

            if (chosenAns === activeTarget.ans) {
                playSfx('laser');
                const targetX = activeTarget.x;
                const targetY = activeTarget.y;

                lasers.push({
                    x1: width / 2, y1: height - 10,
                    x2: targetX, y2: targetY,
                    alpha: 1,
                    color: activeTarget.isBoss ? '#ffe600' : '#00f0ff'
                });

                const scoreMult = gameMode === 'challenge' ? 1.5 : 1.0;
                const basePts = activeTarget.isBoss ? (700 * currentWave) : (100 * currentWave);
                const earnedScore = Math.round(basePts * scoreMult);
                score += earnedScore;

                createSparks(targetX, targetY, activeTarget.color, activeTarget.isBoss ? 45 : 25);
                addFloatingText(targetX, targetY - 20, `🎯 擊破！+${earnedScore}分`, '#ffe600', activeTarget.isBoss ? 24 : 18);

                playSfx('boom');
                screenShake = activeTarget.isBoss ? 20 : 8;
                meteors = [];

                minionIndex++;
                updateProgressUI();

                if (minionIndex > 10) {
                    if (currentWave < 8) {
                        nukeCount++;
                        addFloatingText(width / 2, height / 2, `🎉 WAVE ${currentWave} 完成！獲得 a⁰ 炸彈！`, '#39ff14', 26);
                        setTimeout(() => startWave(currentWave + 1), 1500);
                    } else {
                        gameOver(true);
                    }
                } else {
                    setTimeout(spawnNextInWave, 400);
                }
            } else {
                // ⚡ 算錯扣 14.3% HP（剛好 7 次陣亡）
                playSfx('hit');
                const penalty = 14.3;
                hp = Math.max(0, hp - penalty);
                screenShake = 6;

                btnEl.classList.add('btn-wrong');
                btnEl.disabled = true;

                addFloatingText(width / 2, height - 70, `❌ 運算錯誤！防線 HP -${Math.round(penalty)}%`, '#ff0055', 18);
                
                if (gameMode === 'normal' && activeTarget.hint) {
                    showHint(activeTarget.hint);
                }

                updateHUD();
                if (hp <= 0.5) gameOver(false);
            }
            updateHUD();
        }

        function showHint(hintHtml) {
            const modal = document.getElementById('hint-modal');
            const content = document.getElementById('hint-content');
            content.innerHTML = hintHtml;
            modal.classList.remove('hidden');
        }

        function closeHint() {
            document.getElementById('hint-modal').classList.add('hidden');
        }

        function useNuke() {
            if (nukeCount <= 0 || meteors.length === 0 || isPaused) return;
            nukeCount--;
            playSfx('nuke');
            screenShake = 22;

            meteors.forEach(m => {
                createSparks(m.x, m.y, '#ffe600', 30);
                score += 250;
            });
            meteors = [];
            addFloatingText(width / 2, height / 2, "💣 a⁰ 零指數奧義：全屏化為 1！", '#ffe600', 26);
            
            minionIndex++;
            updateProgressUI();

            if (minionIndex > 10) {
                if (currentWave < 8) {
                    setTimeout(() => startWave(currentWave + 1), 1200);
                } else {
                    gameOver(true);
                }
            } else {
                setTimeout(spawnNextInWave, 500);
            }
            updateHUD();
        }

        function createSparks(x, y, color, count) {
            for (let i = 0; i < count; i++) {
                const angle = Math.random() * Math.PI * 2;
                const spd = Math.random() * 5 + 2;
                particles.push({
                    x, y,
                    vx: Math.cos(angle) * spd,
                    vy: Math.sin(angle) * spd,
                    size: Math.random() * 3 + 2,
                    color,
                    life: 1
                });
            }
        }

        function addFloatingText(x, y, text, color, size = 18) {
            floatingTexts.push({ x, y, text, color, size, life: 1 });
        }

        function gameLoop() {
            if (!gameRunning || isPaused) return;

            ctx.save();
            if (screenShake > 0) {
                ctx.translate((Math.random() - 0.5) * screenShake, (Math.random() - 0.5) * screenShake);
                screenShake *= 0.88;
            }

            ctx.fillStyle = '#070913';
            ctx.fillRect(0, 0, width, height);

            ctx.fillStyle = '#ffffff';
            stars.forEach(s => {
                s.y += s.speed;
                if (s.y > height) s.y = 0;
                ctx.fillRect(s.x, s.y, s.size, s.size);
            });

            meteors.forEach((m) => {
                m.y += m.speed;

                ctx.shadowBlur = m.isBoss ? 25 : 15;
                ctx.shadowColor = m.color;
                ctx.fillStyle = m.color;
                ctx.beginPath();
                ctx.arc(m.x, m.y, m.radius, 0, Math.PI * 2);
                ctx.fill();
                ctx.shadowBlur = 0;

                ctx.fillStyle = '#0f172a';
                ctx.beginPath();
                ctx.arc(m.x, m.y, m.radius - 4, 0, Math.PI * 2);
                ctx.fill();

                ctx.fillStyle = '#ffffff';
                ctx.font = `bold ${m.isBoss ? 15 : 16}px 'Segoe UI', sans-serif`;
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText(m.exp, m.x, m.y);

                if (m.isBoss) {
                    ctx.font = `bold 12px 'Chakra Petch', sans-serif`;
                    ctx.fillStyle = '#ffe600';
                    ctx.fillText(`${m.bossName}`, m.x, m.y - m.radius - 12);
                }

                if (m.y > height - 20) {
                    hp -= m.isBoss ? 35 : 20;
                    playSfx('boom');
                    screenShake = 18;
                    createSparks(m.x, height, '#ff0055', 30);
                    meteors = [];
                    minionIndex++;
                    updateProgressUI();
                    updateHUD();

                    if (hp <= 0.5) {
                        gameOver(false);
                    } else {
                        if (minionIndex > 10 && currentWave < 8) {
                            startWave(currentWave + 1);
                        } else {
                            setTimeout(spawnNextInWave, 600);
                        }
                    }
                }
            });

            lasers.forEach((l, idx) => {
                ctx.strokeStyle = l.color;
                ctx.lineWidth = 5;
                ctx.beginPath();
                ctx.moveTo(l.x1, l.y1);
                ctx.lineTo(l.x2, l.y2);
                ctx.stroke();
                l.alpha -= 0.12;
                if (l.alpha <= 0) lasers.splice(idx, 1);
            });

            particles.forEach((p, idx) => {
                p.x += p.vx;
                p.y += p.vy;
                p.life -= 0.03;
                ctx.fillStyle = p.color;
                ctx.globalAlpha = Math.max(0, p.life);
                ctx.fillRect(p.x, p.y, p.size, p.size);
                ctx.globalAlpha = 1;
                if (p.life <= 0) particles.splice(idx, 1);
            });

            floatingTexts.forEach((t, idx) => {
                t.y -= 0.9;
                t.life -= 0.018;
                ctx.font = `bold ${t.size}px 'Chakra Petch', sans-serif`;
                ctx.fillStyle = t.color;
                ctx.globalAlpha = Math.max(0, t.life);
                ctx.fillText(t.text, t.x, t.y);
                ctx.globalAlpha = 1;
                if (t.life <= 0) floatingTexts.splice(idx, 1);
            });

            ctx.fillStyle = '#00f0ff';
            ctx.beginPath();
            ctx.arc(width / 2, height, 34, Math.PI, 0);
            ctx.fill();

            ctx.restore();
            requestAnimationFrame(gameLoop);
        }

        function updateHUD() {
            document.getElementById('score-val').innerText = score;
            document.getElementById('hp-val').innerText = Math.max(0, Math.ceil(hp));
            document.getElementById('wave-val').innerText = currentWave;

            const nukeBtn = document.getElementById('nuke-btn');
            document.getElementById('nuke-count').innerText = nukeCount;
            nukeBtn.disabled = nukeCount <= 0;
        }

        function gameOver(isWin) {
            gameRunning = false;
            isPaused = false;
            document.getElementById('gameover-screen').classList.remove('hidden');
            document.getElementById('final-score').innerText = score;

            const titleEl = document.getElementById('over-title');
            const msgEl = document.getElementById('over-msg');
            const rankTitleEl = document.getElementById('player-title');

            const modeLabel = gameMode === 'challenge' ? '🔥 菁英' : '🔰 基礎';

            if (isWin) {
                titleEl.innerText = "👑 完美通關！全星域解放！";
                titleEl.style.color = "var(--neon-yellow)";
                msgEl.innerText = `太強了！你以 [${modeLabel}] 模式完美擊退 80 隻雜兵與全部 8 大指數魔王！`;
                rankTitleEl.innerText = gameMode === 'challenge' ? "獲得稱號: 🌌 宇宙指數之神 (DSE 5** 滿分戰力)" : "獲得稱號: 🛡️ 指數榮譽防衛長";
            } else {
                titleEl.innerText = "防線失守！";
                titleEl.style.color = "var(--neon-pink)";
                msgEl.innerText = `你在第 ${currentWave} 關倒下了，在草稿紙上多驗算一步就能過關！`;
                
                let title = "指數實習生 🐣";
                if (score >= 6000) title = "⚡ 代數特攻戰神";
                else if (score >= 3000) title = "🛡️ 資深指數兵長";
                rankTitleEl.innerText = `獲得稱號: [${modeLabel}] ${title}`;
            }
        }

        function getScores() {
            return JSON.parse(localStorage.getItem('index_blast_final_ranks') || '[]');
        }

        function saveRecord() {
            const nameInput = document.getElementById('player-name');
            const name = nameInput.value.trim() || '無名特工';
            const ranks = getScores();

            ranks.push({ 
                name, 
                score, 
                wave: currentWave,
                mode: gameMode === 'challenge' ? '🔥 菁英' : '🔰 基礎'
            });
            ranks.sort((a, b) => b.score - a.score);
            localStorage.setItem('index_blast_final_ranks', JSON.stringify(ranks.slice(0, 10)));
            showLeaderboard();
        }

        function showLeaderboard() {
            const ranks = getScores();
            const body = document.getElementById('rank-body');
            body.innerHTML = '';

            if (ranks.length === 0) {
                body.innerHTML = '<tr><td colspan="5" style="color: #64748b;">暫無特工紀錄</td></tr>';
            } else {
                ranks.forEach((r, idx) => {
                    const row = document.createElement('tr');
                    let rankBadge = `${idx + 1}`;
                    if (idx === 0) rankBadge = '🥇 1';
                    if (idx === 1) rankBadge = '🥈 2';
                    if (idx === 2) rankBadge = '🥉 3';

                    row.innerHTML = `
                        <td style="color: var(--neon-yellow); font-weight: bold;">${rankBadge}</td>
                        <td style="font-weight: 700;">${r.name}</td>
                        <td>${r.mode || '🔰 基礎'}</td>
                        <td>Wave ${r.wave}</td>
                        <td style="color: var(--neon-blue); font-weight: 800;">${r.score}</td>
                    `;
                    body.appendChild(row);
                });
            }
            document.getElementById('leaderboard-screen').classList.remove('hidden');
        }

        function closeLeaderboard() {
            document.getElementById('leaderboard-screen').classList.add('hidden');
        }

        function clearRanks() {
            if (confirm('確定清空所有排行榜紀錄？')) {
                localStorage.removeItem('index_blast_final_ranks');
                showLeaderboard();
            }
        }

        window.onload = showStartScreen;
    </script>
</body>
</html>
